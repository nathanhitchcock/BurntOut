config_version=5

[application]

config/name="Burnt Out"
run/main_scene="uid://dmm7dvgkio3h7"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

UIAnchor="*res://scenes/ui/control_root.tscn"
player_data="*res://scripts/player_data.gd"
GlobalAudio="*res://assets/audio/global_audio.tscn"
GlobalUI="*res://scenes/ui/global_ui.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=600
window/size/initial_position_type=4
window/size/always_on_top=true
window/stretch/mode="viewport"

